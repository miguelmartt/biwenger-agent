# --- AUTENTICACIÓN ---
# Opción A) Cuenta con contraseña propia de Biwenger: rellena email y password.
BIWENGER_EMAIL=
BIWENGER_PASSWORD=
# Opción B) Cuenta con login social (Google/Facebook/Apple): NO hay contraseña,
# así que deja email/password vacíos y pega aquí tu token de sesión.
# Cómo sacarlo: entra a biwenger.as.com logueado, abre la consola del navegador
# (F12 -> Console) y ejecuta:  localStorage.getItem('satellizer_token')
# Copia el texto que devuelve (sin las comillas) y pégalo aquí.
BIWENGER_TOKEN=

# IDs de contexto de TU liga. OJO: BIWENGER_USER_ID es el id del EQUIPO dentro
# de la liga, NO el id de cuenta. Si los dejas vacíos, el cliente los resuelve
# solo tras el login (/account). Puedes verlos en las peticiones de la web (F12).
BIWENGER_LEAGUE_ID=
BIWENGER_USER_ID=
# Versión actual de la app Biwenger. Si ves errores "Old version", súbela al
# número actual (se ve en la URL del bundle: cdn.biwenger.com/app/vXXX/...).
BIWENGER_APP_VERSION=631

# (Opcional) Tu nombre, solo para personalizar el saludo diario del bot.
# Si lo dejas vacío, el saludo es genérico.
OWNER_NAME=

# Bot de Telegram para notificaciones (crea uno con @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Base de datos (SQLite en el volumen Docker /data, persiste el histórico).
DATABASE_URL=sqlite:////data/biwenger.db
# Para desarrollo local sin Docker, usa en su lugar:
# DATABASE_URL=sqlite:///./biwenger.db

# Modo seguro: si es true, las acciones (fichar/pujar/cláusula) solo se SIMULAN.
# Ponlo en false para que el bot actúe de verdad (siempre tras tu confirmación por botón).
DRY_RUN=false

# Colchón de presupuesto que nunca se toca al calcular pujas máximas
BUDGET_SAFETY_MARGIN=1000000
